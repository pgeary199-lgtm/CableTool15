/**********************************************************************
Function
    CT_write_geometry_report

Purpose
    Reads the selected string, calculates geometry, and writes a report.
**********************************************************************/

/**********************************************************************
Function
    CT_catenary_rl

Purpose
    Evaluates the fitted vertical catenary.

Equation
    RL = z0 + a * (cosh((x-x0)/a) - 1)

    x0 = chainage of the true lowest point
    z0 = RL of the true lowest point
**********************************************************************/
Real CT_catenary_rl(Real x, Real a, Real x0, Real z0)
{
  return(z0 + a*(Cosh((x-x0)/a)-1.0));
}

/**********************************************************************
Function
    CT_fit_error

Purpose
    For a trial a and x0, calculates the optimum z0 and SSE.
**********************************************************************/
Real CT_fit_error(Element string, Text string_type, Integer point_count,
                  Real ax, Real ay, Real ux, Real uy,
                  Real a, Real x0, Real &z0)
{
  Real sum_z0 = 0.0;

  for(Integer i=1;i<=point_count;i++) {
    Real x,y,z;
    Integer ok = CT_get_string_xyz(string,string_type,i,x,y,z);
    if(ok != TRUE) return(1.0e30);

    Real rx = x-ax;
    Real ry = y-ay;
    Real along = rx*ux + ry*uy;
    Real shape = a*(Cosh((along-x0)/a)-1.0);

    sum_z0 += z-shape;
  }

  z0 = sum_z0/point_count;

  Real sse = 0.0;

  for(Integer j=1;j<=point_count;j++) {
    Real xj,yj,zj;
    Integer okj = CT_get_string_xyz(string,string_type,j,xj,yj,zj);
    if(okj != TRUE) return(1.0e30);

    Real rxj = xj-ax;
    Real ryj = yj-ay;
    Real alongj = rxj*ux + ryj*uy;
    Real fitted = CT_catenary_rl(alongj,a,x0,z0);
    Real residual = zj-fitted;

    sse += residual*residual;
  }

  return(sse);
}

/**********************************************************************
Function
    CT_write_solver_report

Purpose
    Fits a true vertical catenary to Along + RL observations.

Notes
    Prototype #1 is intentionally report-only.
    Lateral offsets are retained and reported separately, but they do
    NOT influence the vertical catenary solution.
**********************************************************************/
Integer CT005_fit_and_create(Element string,
                               Message_Box message,
                               Text report_name,
                               Text output_name,
                               Model output_model,
                               Integer output_colour,
                               Real design_sag,
                               Real survey_temperature,
                               Real design_temperature)
{
  Text string_name;
  Text string_type;
  Get_name(string,string_name);
  Get_type(string,string_type);

  Integer point_count;
  Get_points(string,point_count);

  if(point_count < 5) {
    Set_data(message,"CT004 P2 requires at least 5 surveyed points.");
    return(FALSE);
  }

  Real ax,ay,az,bx,by,bz;
  Integer ok = CT_get_string_xyz(string,string_type,1,ax,ay,az);
  if(ok != TRUE) {
    Set_data(message,"Unsupported string type: " + string_type);
    return(FALSE);
  }

  ok = CT_get_string_xyz(string,string_type,point_count,bx,by,bz);
  if(ok != TRUE) {
    Set_data(message,"Unable to read Attachment B.");
    return(FALSE);
  }

  Real dx = bx-ax;
  Real dy = by-ay;
  Real span = Sqrt(dx*dx + dy*dy);

  if(span <= 0.0) {
    Set_data(message,"Attachment A and B have the same horizontal position.");
    return(FALSE);
  }

  Real ux = dx/span;
  Real uy = dy/span;
  Real vx = -uy;
  Real vy = ux;

  /*
     Endpoint-constrained catenary.

     For a trial 'a', the Attachment A/B elevations determine x0 exactly:

       zB-zA = a[cosh((L-x0)/a)-cosh(x0/a)]

     Using:
       cosh(u-v)-cosh(u) =
       cosh(u)(cosh(v)-1) - sinh(u)sinh(v)

     Solve for u=x0/a:
       A*cosh(u) - B*sinh(u) = delta/a

     Rather than depend on inverse hyperbolic functions in 12d V15,
     P2 solves x0 numerically for each trial a using bisection.

     Once x0 is known:
       z0 = zA - a*(cosh(x0/a)-1)

     The search then chooses 'a' that minimises SSE of interior survey
     observations. Attachments are fixed by definition and are not used
     to drive the residual minimisation.
  */

  Real best_a = span*5.0;
  Real best_x0 = span*0.5;
  Real best_z0 = az;
  Real best_sse = 1.0e30;

  Real a_min = span*0.25;
  Real a_max = span*20.0;

  Integer passes = 6;

  for(Integer pass=1;pass<=passes;pass++) {

    Integer na = 100;
    Real da = (a_max-a_min)/(na-1);

    for(Integer ia=0;ia<na;ia++) {

      Real trial_a = a_min + ia*da;
      if(trial_a <= 0.0) continue;

      /*
         Solve x0 from the two attachment RLs.
         Wide bounds permit the true low point to lie outside the span
         for unusual attachment-height combinations.
      */
      Real lo = -span*10.0;
      Real hi =  span*10.0;

      for(Integer bi=1;bi<=80;bi++) {
        Real mid = (lo+hi)*0.5;

        Real fmid =
          az + trial_a*(Cosh((span-mid)/trial_a)-Cosh(mid/trial_a)) - bz;

        /*
           f(x0) is monotonically decreasing for positive a and span.
        */
        if(fmid > 0.0)
          lo = mid;
        else
          hi = mid;
      }

      Real trial_x0 = (lo+hi)*0.5;
      Real trial_z0 =
        az - trial_a*(Cosh(trial_x0/trial_a)-1.0);

      Real trial_sse = 0.0;

      for(Integer j=2;j<point_count;j++) {
        Real xj,yj,zj;
        Integer okj = CT_get_string_xyz(string,string_type,j,xj,yj,zj);
        if(okj != TRUE) {
          trial_sse = 1.0e30;
          break;
        }

        Real rxj = xj-ax;
        Real ryj = yj-ay;
        Real alongj = rxj*ux + ryj*uy;
        Real fitted =
          CT_catenary_rl(alongj,trial_a,trial_x0,trial_z0);
        Real residual = zj-fitted;

        trial_sse += residual*residual;
      }

      if(trial_sse < best_sse) {
        best_sse = trial_sse;
        best_a = trial_a;
        best_x0 = trial_x0;
        best_z0 = trial_z0;
      }
    }

    Real old_da = da;
    a_min = best_a-old_da*2.0;
    a_max = best_a+old_da*2.0;

    if(a_min < span*0.05) a_min = span*0.05;
  }

  Integer interior_count = point_count-2;
  Real rms = Sqrt(best_sse/interior_count);
  Real max_abs_residual = 0.0;
  Integer max_residual_point = 2;

  Real max_abs_offset = 0.0;
  Real sum_offset2 = 0.0;

  Real chord_low_rl = az + (bz-az)*(best_x0/span);
  Real sag_at_low = chord_low_rl-best_z0;

  // Midspan sag for direct comparison with common field/design sag methods.
  Real midspan_ch = span*0.5;
  Real midspan_fit_rl = CT_catenary_rl(midspan_ch,best_a,best_x0,best_z0);
  Real midspan_chord_rl = az + (bz-az)*0.5;
  Real midspan_sag = midspan_chord_rl-midspan_fit_rl;

  // Optional design comparison. A design sag <= 0 means no design
  // comparison was supplied for this run.
  Integer design_compare_on = FALSE;
  Real design_difference = 0.0;
  Real design_difference_pct = 0.0;

  if(design_sag > 0.0) {
    design_compare_on = TRUE;
    design_difference = midspan_sag-design_sag;
    design_difference_pct = 100.0*design_difference/design_sag;
  }

  /*
     Exact catenary arc length between Attachment A (x=0)
     and Attachment B (x=span):

       S = a * [sinh((span-x0)/a) + sinh(x0/a)]
  */
  Real fitted_cable_length =
    best_a * (Sinh((span-best_x0)/best_a) + Sinh(best_x0/best_a));

  Real straight_3d_span =
    Sqrt(span*span + (bz-az)*(bz-az));

  Real excess_over_straight =
    fitted_cable_length - straight_3d_span;

  /* Endpoint closure checks. */
  Real fit_a = CT_catenary_rl(0.0,best_a,best_x0,best_z0);
  Real fit_b = CT_catenary_rl(span,best_a,best_x0,best_z0);
  Real closure_a = fit_a-az;
  Real closure_b = fit_b-bz;

  File report_file;
  if(File_exists(report_name)) File_delete(report_name);
  File_open(report_name,"w+","",report_file);

  CT_write_report_line(report_file,"============================================================");
  CT_write_report_line(report_file,"CableTool15 - From Survey to Confidence");
  CT_write_report_line(report_file,"CT005 Fitted Catenary String - Prototype 1D");
  CT_write_report_line(report_file,"ENDPOINT-CONSTRAINED FIT + CABLE LENGTH");
  CT_write_report_line(report_file,"Version 0.5.4");
  CT_write_report_line(report_file,"============================================================");
  CT_write_report_line(report_file,"");
  CT_write_report_line(report_file,"String Name : " + string_name);
  CT_write_report_line(report_file,"String Type : " + string_type);
  CT_write_report_line(report_file,"Survey Pts  : " + To_text(point_count));
  CT_write_report_line(report_file,"");
  CT_write_report_line(report_file,"Attachment A");
  CT_write_report_line(report_file,"  Easting  : " + To_text(ax,"%.3lf"));
  CT_write_report_line(report_file,"  Northing : " + To_text(ay,"%.3lf"));
  CT_write_report_line(report_file,"  RL       : " + To_text(az,"%.3lf"));
  CT_write_report_line(report_file,"");
  CT_write_report_line(report_file,"Attachment B");
  CT_write_report_line(report_file,"  Easting  : " + To_text(bx,"%.3lf"));
  CT_write_report_line(report_file,"  Northing : " + To_text(by,"%.3lf"));
  CT_write_report_line(report_file,"  RL       : " + To_text(bz,"%.3lf"));
  CT_write_report_line(report_file,"");
  CT_write_report_line(report_file,"Horizontal Span : " + To_text(span,"%.3lf") + " m");
  CT_write_report_line(report_file,"Vertical Diff   : " + To_text(bz-az,"%.3lf") + " m (B-A)");
  CT_write_report_line(report_file,"");
  CT_write_report_line(report_file,"ATTACHMENT CONTROL");
  CT_write_report_line(report_file,"  Attachment A          : FIXED TO SURVEY");
  CT_write_report_line(report_file,"  Attachment B          : FIXED TO SURVEY");
  CT_write_report_line(report_file,"  Interior fit points   : " + To_text(interior_count));
  CT_write_report_line(report_file,"  Fit type              : ENDPOINT-CONSTRAINED TRUE CATENARY");
  CT_write_report_line(report_file,"");
  CT_write_report_line(report_file,"CONSTRAINED VERTICAL CATENARY SOLUTION");
  CT_write_report_line(report_file,"  Equation              : RL = z0 + a*(cosh((x-x0)/a)-1)");
  CT_write_report_line(report_file,"  Catenary a            : " + To_text(best_a,"%.6lf") + " m");
  CT_write_report_line(report_file,"  Lowest point chainage : " + To_text(best_x0,"%.6lf") + " m from Attachment A");
  CT_write_report_line(report_file,"  Lowest point RL       : " + To_text(best_z0,"%.6lf") + " m");
  CT_write_report_line(report_file,"  Chord RL at low point : " + To_text(chord_low_rl,"%.6lf") + " m");
  CT_write_report_line(report_file,"  Sag at true low point : " + To_text(sag_at_low,"%.6lf") + " m");
  CT_write_report_line(report_file,"");
  CT_write_report_line(report_file,"MIDSPAN SAG - FIELD/DESIGN COMPARISON");
  CT_write_report_line(report_file,"  Midspan chainage      : " + To_text(midspan_ch,"%.6lf") + " m from Attachment A");
  CT_write_report_line(report_file,"  Midspan conductor RL  : " + To_text(midspan_fit_rl,"%.6lf") + " m");
  CT_write_report_line(report_file,"  Midspan chord RL      : " + To_text(midspan_chord_rl,"%.6lf") + " m");
  CT_write_report_line(report_file,"  Midspan sag           : " + To_text(midspan_sag,"%.6lf") + " m");
  CT_write_report_line(report_file,"");

  CT_write_report_line(report_file,"DESIGN SAG COMPARISON");
  if(design_compare_on == TRUE) {
    CT_write_report_line(report_file,"  Design sag            : " + To_text(design_sag,"%.3lf") + " m");
    CT_write_report_line(report_file,"  CT005 midspan sag     : " + To_text(midspan_sag,"%.3lf") + " m");
    CT_write_report_line(report_file,"  Difference            : " + To_text(design_difference,"%+.3lf") + " m");
    CT_write_report_line(report_file,"  Difference from design: " + To_text(design_difference_pct,"%+.2lf") + " %");

    if(design_temperature != 0.0)
      CT_write_report_line(report_file,"  Design temperature    : " + To_text(design_temperature,"%.1lf") + " C");
    else
      CT_write_report_line(report_file,"  Design temperature    : NOT ENTERED");

    if(survey_temperature != 0.0)
      CT_write_report_line(report_file,"  Survey temperature    : " + To_text(survey_temperature,"%.1lf") + " C");
    else
      CT_write_report_line(report_file,"  Survey temperature    : NOT ENTERED");

    CT_write_report_line(report_file,"  Comparison basis      : MIDSPAN SAG");
    CT_write_report_line(report_file,"  Note                  : compare only when conditions/design state are suitable.");
  }
  else {
    CT_write_report_line(report_file,"  Design sag            : NOT ENTERED");
    CT_write_report_line(report_file,"  Comparison            : NOT CALCULATED");
  }
  CT_write_report_line(report_file,"");

  CT_write_report_line(report_file,"  Fitted cable length   : " + To_text(fitted_cable_length,"%.6lf") + " m");
  CT_write_report_line(report_file,"  Straight 3D span      : " + To_text(straight_3d_span,"%.6lf") + " m");
  CT_write_report_line(report_file,"  Excess cable length   : " + To_text(excess_over_straight,"%.6lf") + " m");
  CT_write_report_line(report_file,"  Interior RMS residual : " + To_text(rms,"%.6lf") + " m");
  CT_write_report_line(report_file,"");
  CT_write_report_line(report_file,"ATTACHMENT CLOSURE");
  CT_write_report_line(report_file,"  Attachment A closure  : " + To_text(closure_a,"%.9lf") + " m");
  CT_write_report_line(report_file,"  Attachment B closure  : " + To_text(closure_b,"%.9lf") + " m");
  CT_write_report_line(report_file,"");
  CT_write_report_line(report_file,"Point       Along(m)       RL(m)      Fit RL(m)    Residual(m)    Offset(m)");
  CT_write_report_line(report_file,"----------------------------------------------------------------------------");

  for(Integer k=1;k<=point_count;k++) {
    Real xk,yk,zk;
    ok = CT_get_string_xyz(string,string_type,k,xk,yk,zk);

    if(ok != TRUE) {
      File_close(report_file);
      Set_data(message,"Unable to read point " + To_text(k));
      return(FALSE);
    }

    Real rxk = xk-ax;
    Real ryk = yk-ay;
    Real alongk = rxk*ux + ryk*uy;
    Real offsetk = rxk*vx + ryk*vy;
    Real fitk = CT_catenary_rl(alongk,best_a,best_x0,best_z0);
    Real residualk = zk-fitk;
    Real abs_residual = CT_abs(residualk);
    Real abs_offset = CT_abs(offsetk);

    if(k > 1 && k < point_count) {
      if(abs_residual > max_abs_residual) {
        max_abs_residual = abs_residual;
        max_residual_point = k;
      }
    }

    if(abs_offset > max_abs_offset) max_abs_offset = abs_offset;
    sum_offset2 += offsetk*offsetk;

    Text line = To_text(k,"%5ld") + "  " +
                To_text(alongk,"%12.3lf") + "  " +
                To_text(zk,"%12.3lf") + "  " +
                To_text(fitk,"%12.3lf") + "  " +
                To_text(residualk,"%12.4lf") + "  " +
                To_text(offsetk,"%11.3lf");

    CT_write_report_line(report_file,line);
  }

  Real offset_rms = Sqrt(sum_offset2/point_count);

  CT_write_report_line(report_file,"----------------------------------------------------------------------------");
  CT_write_report_line(report_file,"");
  CT_write_report_line(report_file,"FIT QA - INTERIOR OBSERVATIONS");
  CT_write_report_line(report_file,"  Interior RMS residual : " + To_text(rms,"%.6lf") + " m");
  CT_write_report_line(report_file,"  Maximum residual      : " + To_text(max_abs_residual,"%.6lf") + " m");
  CT_write_report_line(report_file,"  Maximum residual pt   : " + To_text(max_residual_point));
  CT_write_report_line(report_file,"");
  CT_write_report_line(report_file,"ENGINEERING SUMMARY");
  CT_write_report_line(report_file,"  Lowest point chainage : " + To_text(best_x0,"%.3lf") + " m from Attachment A");
  CT_write_report_line(report_file,"  Lowest point RL       : " + To_text(best_z0,"%.3lf") + " m");
  CT_write_report_line(report_file,"  Sag at true low point : " + To_text(sag_at_low,"%.3lf") + " m");
  CT_write_report_line(report_file,"  Midspan sag           : " + To_text(midspan_sag,"%.3lf") + " m");
  if(design_compare_on == TRUE) {
    CT_write_report_line(report_file,"  Design sag            : " + To_text(design_sag,"%.3lf") + " m");
    CT_write_report_line(report_file,"  Design difference     : " + To_text(design_difference,"%+.3lf") + " m");
    CT_write_report_line(report_file,"  Design difference     : " + To_text(design_difference_pct,"%+.2lf") + " %");
  }
  CT_write_report_line(report_file,"  Fitted cable length   : " + To_text(fitted_cable_length,"%.3lf") + " m");
  CT_write_report_line(report_file,"");
  CT_write_report_line(report_file,"LATERAL OBSERVATION QA - NOT USED BY VERTICAL SOLVER");
  CT_write_report_line(report_file,"  Maximum abs offset    : " + To_text(max_abs_offset,"%.3lf") + " m");
  CT_write_report_line(report_file,"  Offset RMS            : " + To_text(offset_rms,"%.3lf") + " m");
  CT_write_report_line(report_file,"  Note                  : smooth lateral movement may reflect wind.");
  CT_write_report_line(report_file,"");
  CT_write_report_line(report_file,"P3 engineering note:");
  CT_write_report_line(report_file,"  Attachment A and B are treated as fixed known points.");
  CT_write_report_line(report_file,"  Only interior observations drive the least-squares fit.");
  CT_write_report_line(report_file,"  Lateral offsets remain observational and do not affect sag.");
  CT_write_report_line(report_file,"");
  CT_write_report_line(report_file,"");
  CT_write_report_line(report_file,"CT005 VISUAL OUTPUT");

  Integer regular_points;
  regular_points = span;
  regular_points += 2;
  if(regular_points < 3) regular_points = 3;

  Integer low_inside = FALSE;
  if(best_x0 > 0.0 && best_x0 < span) low_inside = TRUE;

  Integer fitted_points = regular_points;
  if(low_inside == TRUE) fitted_points += 1;

  Integer flag1 = String_Super_Bit(ZCoord_Array);
  Integer flag2 = 0;

  Print("CT005: creating fitted Super string...");
  Element fitted = Create_super(flag1,flag2,fitted_points);
  Print("CT005: Create_super returned.");

  if(!Element_exists(fitted)) {
    CT_write_report_line(report_file,"  STATUS : FAILED - Create_super returned null.");
    CT_write_report_line(report_file,"============================================================");
    File_flush(report_file);
    File_close(report_file);
    Set_data(message,"CT005 could not create the fitted Super string.");
    return(FALSE);
  }

  Integer create_ok = TRUE;

  Integer low_written = FALSE;

  for(Integer fp=1;fp<=fitted_points;fp++) {
    Real ch;

    if(fp == 1) {
      ch = 0.0;
    } else if(fp == fitted_points) {
      ch = span;
    } else {
      Integer regular_index = fp-1;
      Real regular_ch = span*regular_index/(regular_points-1);

      if(low_inside == TRUE && low_written == FALSE && regular_ch >= best_x0) {
        ch = best_x0;
        low_written = TRUE;
      } else {
        if(low_inside == TRUE && low_written == TRUE)
          regular_index -= 1;

        ch = span*regular_index/(regular_points-1);
      }
    }

    Real gx = ax + ux*ch;
    Real gy = ay + uy*ch;
    Real gz = CT_catenary_rl(ch,best_a,best_x0,best_z0);

    Integer set_ret = Set_super_vertex_coord(fitted,fp,gx,gy,gz);
    if(set_ret != 0) create_ok = FALSE;
  }

  if(create_ok != TRUE) {
    Element_delete(fitted);
    CT_write_report_line(report_file,"  STATUS : FAILED - unable to load fitted vertices.");
    CT_write_report_line(report_file,"============================================================");
    File_flush(report_file);
    File_close(report_file);
    Set_data(message,"CT005 could not load all fitted vertices.");
    return(FALSE);
  }

  Print("CT005: vertices loaded.");

  Text fitted_name = output_name;
  Set_name(fitted,fitted_name);
  Set_colour(fitted,output_colour);
  Print("CT005: fitted string named and coloured.");

  Print("CT005: adding fitted string to selected output model...");
  Integer add_ret = Set_model(fitted,output_model);

  if(add_ret != 0) {
    Element_delete(fitted);
    CT_write_report_line(report_file,"  STATUS : FAILED - could not add fitted string to model.");
    CT_write_report_line(report_file,"============================================================");
    File_flush(report_file);
    File_close(report_file);
    Set_data(message,"CT005 could not add the fitted string to the model.");
    return(FALSE);
  }

  Print("CT005: fitted string added to model.");
  Element_draw(fitted);
  Print("CT005: fitted string drawn.");

  CT_write_report_line(report_file,"  STATUS                 : CREATED");
  CT_write_report_line(report_file,"  String name            : " + fitted_name);
  CT_write_report_line(report_file,"  Fitted vertices        : " + To_text(fitted_points));
  CT_write_report_line(report_file,"  Regular spacing        : approx " + To_text(span/(regular_points-1),"%.3lf") + " m");
  CT_write_report_line(report_file,"  Exact low-point vertex : YES");
  CT_write_report_line(report_file,"  Output colour number   : " + To_text(output_colour));
  CT_write_report_line(report_file,"  Attachment A           : EXACT");
  CT_write_report_line(report_file,"  Attachment B           : EXACT");
  CT_write_report_line(report_file,"");
  CT_write_report_line(report_file,"The original surveyed string was not modified.");
  CT_write_report_line(report_file,"============================================================");

  File_flush(report_file);
  File_close(report_file);

  Set_data(message,"CT005 created: " + fitted_name + " | Report: " + report_name);
  Print("CableTool15 CT005 created fitted catenary: " + fitted_name);

  return(TRUE);
}


/**********************************************************************
Function
    CT005_manage_panel
**********************************************************************/
void CT005_manage_panel()
{
  Panel panel = Create_panel("CableTool15 - CT005 P1D Validation Report");

  Message_Box message = Create_message_box(
    "Select survey string, choose output settings, then Create Fitted Catenary.");

  Vertical_Group source_group = Create_vertical_group(0);
  Set_border(source_group,"Survey Source");

  Select_Box select_box = Create_select_box(
    "&Survey string",
    "Pick surveyed conductor string",
    SELECT_STRING,
    message);

  Append(select_box,source_group);

  Vertical_Group output_group = Create_vertical_group(0);
  Set_border(output_group,"Fitted Catenary Output");

  Name_Box name_box = Create_name_box("String Name",message);
  Set_data(name_box,"CABLE REF - FITTED CATENARY");

  Model_Box model_box =
    Create_model_box("Model Name",message,CHECK_MODEL_CREATE);
  Set_data(model_box,"CableTool15 - Fitted Catenary");

  Colour_Box colour_box = Create_colour_box("Colour",message);
  Set_data(colour_box,"green");

  File_Box report_box =
    Create_file_box("Report File Name",message,CHECK_FILE_CREATE,"*.rpt");
  Set_data(report_box,"CableTool15_CT005_FittedCatenary.rpt");

  Append(name_box,output_group);
  Append(model_box,output_group);
  Append(colour_box,output_group);
  Append(report_box,output_group);

  Vertical_Group validation_group = Create_vertical_group(0);
  Set_border(validation_group,"Optional Design Validation");

  Real_Box design_sag_box =
    Create_real_box("Design Sag (m, 0 = skip)",message);
  Set_data(design_sag_box,0.0);

  Real_Box survey_temp_box =
    Create_real_box("Survey Temperature (C, 0 = blank)",message);
  Set_data(survey_temp_box,0.0);

  Real_Box design_temp_box =
    Create_real_box("Design Temperature (C, 0 = blank)",message);
  Set_data(design_temp_box,0.0);

  Append(design_sag_box,validation_group);
  Append(survey_temp_box,validation_group);
  Append(design_temp_box,validation_group);

  Horizontal_Group button_group = Create_button_group();
  Set_border(button_group,"Processing");

  Button fit_button = Create_button("&Create Fitted Catenary","fit");
  Button finish_button = Create_button("&Finish","finish");

  Append(fit_button,button_group);
  Append(finish_button,button_group);

  Append(source_group,panel);
  Append(output_group,panel);
  Append(validation_group,panel);
  Append(message,panel);
  Append(button_group,panel);

  Show_widget(panel);

  Integer running = TRUE;

  while(running) {
    Integer id;
    Text cmd;
    Text msg;

    Integer ret = Wait_on_widgets(id,cmd,msg);
    if(cmd == "keystroke") continue;

    switch(id) {
      case Get_id(panel) : {
        if(cmd == "Panel Quit") running = FALSE;
      } break;

      case Get_id(finish_button) : {
        if(cmd == "finish") running = FALSE;
      } break;

      case Get_id(fit_button) : {
        Element selected_string;
        Integer ierr = Validate(select_box,selected_string);

        if(ierr != TRUE) {
          Set_data(message,"Please select a survey string first.");
          break;
        }

        Text output_name;
        ierr = Validate(name_box,output_name);
        if(ierr != TRUE) {
          Set_data(message,"Please enter a valid fitted string name.");
          break;
        }

        Model output_model;
        ierr = Validate(model_box,GET_MODEL_CREATE,output_model);
        if(ierr != MODEL_EXISTS) {
          Set_data(message,"Please enter or select a valid output model.");
          break;
        }

        Integer output_colour;
        ierr = Validate(colour_box,output_colour);
        if(ierr != TRUE) {
          Set_data(message,"Please enter or select a valid colour.");
          break;
        }

        Text report_name;
        Integer report_get = Get_data(report_box,report_name);
        if(report_get != 0 || report_name == "") {
          Set_data(message,"Please enter a report file name.");
          break;
        }

        Real design_sag;
        ierr = Validate(design_sag_box,design_sag);
        if(ierr != TRUE) {
          Set_data(message,"Please enter a valid Design Sag (use 0 to skip).");
          break;
        }

        Real survey_temperature;
        ierr = Validate(survey_temp_box,survey_temperature);
        if(ierr != TRUE) {
          Set_data(message,"Please enter a valid Survey Temperature (use 0 if blank).");
          break;
        }

        Real design_temperature;
        ierr = Validate(design_temp_box,design_temperature);
        if(ierr != TRUE) {
          Set_data(message,"Please enter a valid Design Temperature (use 0 if blank).");
          break;
        }

        CT005_fit_and_create(
          selected_string,
          message,
          report_name,
          output_name,
          output_model,
          output_colour,
          design_sag,
          survey_temperature,
          design_temperature);
      } break;
    }
  }
}

void main()
{
  CT005_manage_panel();
}
